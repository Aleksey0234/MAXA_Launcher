<?xml version='1.0' encoding='utf-8'?>
<widget id="com.MAXA_PHONE_LAUNCHER.launcher" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <feature name="Kiosk">
        <param name="android-package" value="org.cordova.plugin.labs.kiosk.Kiosk" />
    </feature>
    <feature name="Applist">
        <param name="android-package" value="org.jmrezayi2.Applist.Applist" />
    </feature>
    <feature name="Launcher">
        <param name="android-package" value="com.hutchind.cordova.plugins.launcher.Launcher" />
    </feature>
    <name>MAXA Launcher</name>
    <description>
        MAXA Launcher — замена стандартного рабочего стола Android.
    </description>
    <author email="dev@cordova.apache.org" href="https://cordova.apache.org">
        Apache Cordova Team
    </author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="loglevel" value="DEBUG" />
    <preference name="Fullscreen" value="true" />
    <preference name="FullscreenNotImmersive" value="true" />
    <preference name="AndroidEdgeToEdge" value="true" />
</widget>
